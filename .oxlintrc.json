{
  "$schema": "./node_modules/@effect/tsgo/oxlint-schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error"
  },
  "rules": {
    "complexity": [
      "error",
      8
    ],
    "max-depth": [
      "error",
      3
    ],
    "max-lines-per-function": [
      "error",
      50
    ],
    "max-nested-callbacks": [
      "error",
      2
    ],
    "max-params": [
      "error",
      4
    ],
    "no-console": "error",
    "eqeqeq": "error",
    "no-else-return": "error",
    "prefer-const": "error",
    "typescript/no-explicit-any": "error",
    "typescript/consistent-type-imports": "error",
    "typescript/no-non-null-assertion": "error",
    "unicorn/no-null": "error",
    "import/no-cycle": "error",
    "no-underscore-dangle": [
      "error",
      {
        "allow": [
          "_tag"
        ]
      }
    ],
    "effecttsgo/floating-effect": "error",
    "effecttsgo/missing-effect-error": "error",
    "effecttsgo/missing-effect-context": "error",
    "effecttsgo/class-self-mismatch": "error",
    "effecttsgo/any-unknown-in-error-context": "error",
    "effecttsgo/generic-effect-services": "error",
    "effecttsgo/effect-fn-implicit-any": "error",
    "typescript/no-unsafe-type-assertion": "off"
  },
  "ignorePatterns": [
    "node_modules",
    "dist",
    "tools/fixtures",
    "tools/effect-fixtures"
  ],
  "overrides": [
    {
      "files": [
        "scripts/**/*.ts"
      ],
      "rules": {
        "no-console": "off",
        "max-lines-per-function": "off"
      }
    },
    {
      "files": [
        "**/*.test.ts"
      ],
      "rules": {
        "max-nested-callbacks": [
          "error",
          3
        ],
        "max-lines-per-function": "off"
      }
    },
    {
      "files": [
        "src/**/*.ts"
      ],
      "rules": {
        "adiff/no-comments": "error",
        "adiff/module-boundary": "error",
        "adiff/no-parameter-properties": "error",
        "adiff/one-blank-line": "error",
        "adiff/blank-at-edges": "error",
        "adiff/import-order": "error",
        "adiff/span-name": "error",
        "adiff/service-tag": "error"
      }
    },
    {
      "files": [
        "src/**/*.test.ts"
      ],
      "rules": {
        "adiff/test-title": "error"
      }
    },
    {
      "files": [
        "src/main.ts",
        "src/cli/**/*.ts",
        "src/domain/**/*.ts",
        "src/service/**/*.ts",
        "src/tui/**/*.ts"
      ],
      "rules": {
        "adiff/effect-not-promises": "error"
      }
    },
    {
      "files": [
        "src/**/*.test.ts"
      ],
      "rules": {
        "adiff/no-comments": [
          "error",
          {
            "sections": true
          }
        ]
      }
    },
    {
      "files": [
        "src/main.ts",
        "src/tui/app.ts",
        "src/testing/domains/agent/driver.ts"
      ],
      "rules": {
        "effecttsgo/strict-effect-provide": "off"
      }
    },
    {
      "files": [
        "src/domain/**/*.ts"
      ],
      "rules": {
        "typescript/no-unsafe-type-assertion": "error"
      }
    }
  ],
  "jsPlugins": [
    "./tools/oxlint-adiff.ts"
  ],
  "options": {
    "typeAware": true
  },
  "plugins": [
    "typescript",
    "unicorn",
    "import",
    "oxc",
    "effecttsgo"
  ]
}