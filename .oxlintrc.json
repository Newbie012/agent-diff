{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error"
  },
  "rules": {
    "complexity": [
      "error",
      8
    ],
    "max-depth": [
      "error",
      3
    ],
    "max-lines-per-function": [
      "error",
      50
    ],
    "max-nested-callbacks": [
      "error",
      2
    ],
    "max-params": [
      "error",
      4
    ],
    "no-console": "error",
    "eqeqeq": "error",
    "no-else-return": "error",
    "prefer-const": "error",
    "typescript/no-explicit-any": "error",
    "typescript/consistent-type-imports": "error",
    "typescript/no-non-null-assertion": "error",
    "unicorn/no-null": "error",
    "import/no-cycle": "error",
    "no-underscore-dangle": [
      "error",
      {
        "allow": [
          "_tag"
        ]
      }
    ]
  },
  "ignorePatterns": [
    "node_modules",
    "dist",
    "tools/fixtures"
  ],
  "overrides": [
    {
      "files": [
        "scripts/**/*.ts"
      ],
      "rules": {
        "no-console": "off",
        "max-lines-per-function": "off"
      }
    },
    {
      "files": [
        "**/*.test.ts"
      ],
      "rules": {
        "max-nested-callbacks": [
          "error",
          3
        ],
        "max-lines-per-function": "off"
      }
    },
    {
      "files": [
        "src/**/*.ts"
      ],
      "rules": {
        "adiff/no-comments": "error",
        "adiff/module-boundary": "error",
        "adiff/no-parameter-properties": "error",
        "adiff/one-blank-line": "error",
        "adiff/blank-at-edges": "error",
        "adiff/import-order": "error",
        "adiff/span-name": "error",
        "adiff/service-tag": "error"
      }
    },
    {
      "files": [
        "src/domain/**/*.ts",
        "src/service/**/*.ts"
      ],
      "rules": {
        "adiff/effect-not-promises": "error"
      }
    },
    {
      "files": [
        "src/**/*.test.ts"
      ],
      "rules": {
        "adiff/no-comments": [
          "error",
          {
            "sections": true
          }
        ]
      }
    }
  ],
  "jsPlugins": [
    "./tools/oxlint-adiff.ts"
  ]
}
