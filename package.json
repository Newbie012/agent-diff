{
  "name": "adiff",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "devDependencies": {
    "@effect/vitest": "^4.0.0-beta.102",
    "@types/node": "^26.1.2",
    "oxlint": "^1.76.0",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@opentui/core": "^0.4.5",
    "effect": "^4.0.0-beta.102"
  },
  "scripts": {
    "check": "npm run typecheck && npm run lint && npm test",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint && node scripts/check-style.ts",
    "test": "NODE_OPTIONS=--experimental-ffi vitest run",
    "test:watch": "NODE_OPTIONS=--experimental-ffi vitest",
    "dev": "node --experimental-ffi --disable-warning=ExperimentalWarning src/main.ts",
    "review": "npm run dev -- review --repo ."
  },
  "engines": {
    "node": ">=26"
  },
  "bin": {
    "adiff": "./bin/adiff.js"
  }
}
