{
  "name": "adiff",
  "type": "module",
  "devDependencies": {
    "@effect/vitest": "^4.0.0-beta.102",
    "@types/node": "^26.1.2",
    "oxlint": "^1.76.0",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@opentui/core": "^0.4.5",
    "effect": "^4.0.0-beta.102"
  },
  "scripts": {
    "check": "pnpm run typecheck && pnpm run lint && pnpm test",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint && node scripts/check-style.ts",
    "test": "NODE_OPTIONS=--experimental-ffi vitest run",
    "test:watch": "NODE_OPTIONS=--experimental-ffi vitest",
    "dev": "node --experimental-ffi --disable-warning=ExperimentalWarning src/main.ts",
    "review": "pnpm run dev -- review --repo ."
  },
  "engines": {
    "node": ">=26"
  },
  "bin": {
    "adiff": "./bin/adiff.js"
  },
  "packageManager": "pnpm@12.0.0-beta.3",
  "version": "0.0.0",
  "description": "Review agent work across git worktrees like a PR, and hand the comments back to the agent.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Newbie012/agent-diff.git"
  },
  "files": [
    "bin",
    "src",
    "skills",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  }
}
